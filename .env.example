# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Backend ---------------------------------------------------------------
# Base URL of the API. Its origin is also used for /uploads image URLs and for
# the /api + /uploads rewrites in next.config.ts.
NEXT_PUBLIC_API_URL=https://duckapi.alefmenu.com/api/v1

# Optional: override the rewrite target independently of NEXT_PUBLIC_API_URL.
# BACKEND_ORIGIN=http://localhost:8080

# --- Google services -------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-maps-api-key
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=DEMO_MAP_ID

# --- Payments --------------------------------------------------------------
NEXT_PUBLIC_PAYMENT_METHOD=instapay

# --- SEO & analytics -------------------------------------------------------
# Canonical origin. Drives metadataBase, canonical tags, robots.txt and
# sitemap.xml. On Vercel this falls back to VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=https://duck-client-two.vercel.app

# GA4 measurement ID. Leave unset and no analytics code ships at all.
NEXT_PUBLIC_GA_ID=

# Google Search Console "HTML tag" verification token — the `content` value
# only, not the whole <meta> tag. Unset means no verification meta tag.
GOOGLE_SITE_VERIFICATION=
