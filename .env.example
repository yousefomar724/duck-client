# Copy to .env.local and fill in real values. Never commit .env.local.

# --- Database ----------------------------------------------------------------
MONGODB_URI=

# --- Auth ----------------------------------------------------------------
JWT_SECRET=

# --- Storage (Cloudinary) --------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Google Sign-In ----------------------------------------------------------
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com

# --- Payments --------------------------------------------------------------
# Manual / InstaPay only — no card gateway is configured in this deployment.
NEXT_PUBLIC_PAYMENT_METHOD=instapay

# --- SEO & analytics -------------------------------------------------------
# Canonical origin. Drives metadataBase, canonical tags, robots.txt, sitemap.xml,
# and the link in password-reset emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# GA4 measurement ID. Leave unset and no analytics code ships at all.
NEXT_PUBLIC_GA_ID=

# Google Search Console "HTML tag" verification token — the `content` value
# only, not the whole <meta> tag. Unset means no verification meta tag.
GOOGLE_SITE_VERIFICATION=

# --- Email (password reset, booking notifications) --------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=

# --- Cron (release-bookings and finance-sync endpoints) ---------------------
CRON_SECRET=

# --- Finance ERP: Duck Aswan booking sync -------------------------------------
# Only bookings of this supplier (Duck Aswan) are mirrored into the finance ERP.
# Not a secret. Leave it empty to turn the sync off (nothing is queued or posted).
FINANCE_DUCK_SUPPLIER_ID=6a70a7defacf2773a551ba0c
# Cash/bank account MANUAL (InstaPay / cash) payments are received into.
# Default 1111 Main Cash on Hand; 1114 is the InstaPay account. KASHIER is always 1115.
FINANCE_DUCK_MANUAL_ACCOUNT=1111
# Optional go-live floor (YYYY-MM-DD activity date). The backfill records its own
# --from date, which takes precedence. Earlier bookings are synced only if already linked.
FINANCE_SYNC_FROM=
# Set to 0 to skip the inline sync after each Duck write (the daily cron still runs).
FINANCE_SYNC_INLINE=

# --- Seeder ------------------------------------------------------------------
# Optional — the seeder falls back to development defaults and prints them
# when these are unset. Set them for anything beyond local development.
SEED_ADMIN_PASSWORD=
SEED_SUPPLIER_PASSWORD=
