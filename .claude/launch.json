{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "dev"
      ],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "start",
        "-p",
        "3001"
      ],
      "port": 3001
    },
    {
      "name": "test-server",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/test-server.mjs"
      ],
      "port": 3000
    }
  ]
}
